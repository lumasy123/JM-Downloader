# 下载的漫画、封面和缩略图缓存、导出的备份
downloads/
covers/
thumbs/
backups/

# 构建出来的安装包
*.apk

# 个人数据：设置、黑名单、分组、下载队列、收藏、笔记、动态缓存（第一次启动会自动生成）
config.json
blacklist.json
groups.json
queue.json
favorites.json
notes.json
feed.json

# Python 缓存、本地工具配置
__pycache__/
*.pyc
.claude/

# 生图记录（含本机路径、接口地址），提示词已在 pet_src/prompts/
pet_src/generated/*.meta.json
